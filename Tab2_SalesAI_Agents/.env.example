# Environment Variables for SalesAI SDR
# ======================================
# Copy this file to .env and fill in your API keys

# ── OpenAI Agents SDK ──────────────────────────────────────────
# Required for the six SalesAI Agents SDK agents.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_AGENT_MODEL=gpt-4.1-mini

# Legacy provider helper settings below are used only by compatibility utilities;
# the six capstone agents run through OPENAI_API_KEY.
AI_PROVIDER=gemini

# ── GOOGLE GEMINI API KEY ──────────────────────────────────────
# Get FREE key at: https://aistudio.google.com/
# 1. Go to the link above
# 2. Sign in with Google account
# 3. Click "Get API Key" → "Create API Key"
# 4. Paste it below
GEMINI_API_KEY=your-gemini-api-key-here

# ── GROQ API KEY (FALLBACK) ────────────────────────────────────
# Get FREE key at: https://console.groq.com/
# 1. Sign up at groq.com
# 2. Go to API Keys section
# 3. Create new key and paste below
GROQ_API_KEY=your-groq-api-key-here
