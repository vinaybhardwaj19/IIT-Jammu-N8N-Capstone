{
  "name": "04 - Automated Follow-ups & Meeting Scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 8
            }
          ]
        }
      },
      "id": "cron-node-004",
      "name": "Schedule: Every 8 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, r.full_name as rep_name, r.email as rep_email,\n  EXTRACT(EPOCH FROM (NOW() - l.assigned_at))/3600 as hours_since_assignment,\n  COUNT(f.id) as followup_count,\n  MAX(f.sent_at) as last_followup\nFROM leads l\nJOIN sales_reps r ON l.assigned_rep = r.rep_id\nLEFT JOIN follow_ups f ON l.lead_id = f.lead_id\nWHERE l.status IN ('ASSIGNED', 'CONTACTED')\n  AND l.qualification_status = 'QUALIFIED'\n  AND (\n    (COUNT(f.id) = 0 AND EXTRACT(EPOCH FROM (NOW() - l.assigned_at))/3600 >= 2)\n    OR (COUNT(f.id) > 0 AND EXTRACT(EPOCH FROM (NOW() - MAX(f.sent_at)))/3600 >= 24)\n  )\n  AND COUNT(f.id) < 5\nGROUP BY l.id, r.id\nORDER BY l.composite_score DESC\nLIMIT 50",
        "options": {}
      },
      "id": "postgres-node-004a",
      "name": "Postgres: Get Leads Needing Follow-up",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-crm-db",
          "name": "CRM PostgreSQL"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "splitbatch-node-004",
      "name": "Split: Process Each Lead",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "apiKey",
        "resource": "chat",
        "model": "gpt-4o",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert B2B sales copywriter. You write personalized, high-converting follow-up emails that feel genuinely human—never robotic or generic. Your emails are concise (150-200 words), warm, professional, and always include a clear, low-friction call-to-action. You always reference specific company details to show research. Output ONLY the email body in HTML format, no subject line, no markdown."
            },
            {
              "role": "user",
              "content": "=Write a personalized follow-up email #{{ ($json.followup_count || 0) + 1 }} for this sales lead.\n\nContext:\n- Lead Name: {{ $json.full_name }}\n- Company: {{ $json.company }}\n- Industry: {{ $json.industry }}\n- Budget: {{ $json.budget }}\n- Hours Since Last Contact: {{ Math.round($json.hours_since_assignment || 0) }}\n- Recommended Product: {{ $json.recommended_product }}\n- Deal Probability: {{ $json.deal_probability_percent || 45 }}%\n- Follow-up Number: {{ ($json.followup_count || 0) + 1 }}/5\n\nEmail Type:\n{{ $json.followup_count === 0 ? 'First touch - warm intro from assigned rep' : $json.followup_count === 1 ? 'Value-add - share relevant case study/insight' : $json.followup_count === 2 ? 'Urgency + social proof - limited slots for demo' : $json.followup_count === 3 ? 'Last resort - breakup email with easy re-entry' : 'Final check-in - leave door open' }}\n\nSales Rep: {{ $json.rep_name }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 500
        }
      },
      "id": "openai-node-004",
      "name": "AI: Write Personalized Follow-up Email",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        840,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ [\n  'Quick question about ' + $json.company + ' 🤝',\n  'A thought on ' + $json.industry + ' sales challenges',\n  '5 companies like ' + $json.company + ' grew 3x — here\\'s how',\n  'Should I close your file, ' + $json.full_name.split(' ')[0] + '?',\n  'Final note from SalesFlow'\n][$json.followup_count || 0] }}",
        "emailType": "html",
        "message": "={{ $node['AI: Write Personalized Follow-up Email'].json.choices[0].message.content }}",
        "options": {
          "replyTo": "={{ $json.rep_email }}"
        }
      },
      "id": "gmail-node-004",
      "name": "Gmail: Send Follow-up Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1040,
        200
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-oauth",
          "name": "Gmail Sales Account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.followup_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-node-004",
      "name": "IF: First Follow-up? Book Meeting",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1040,
        420
      ]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "title": "=Discovery Call: {{ $json.full_name }} ({{ $json.company }}) × {{ $json.rep_name }}",
        "start": "={{ $now.plus({days: 2}).startOf('day').plus({hours: 10}).toISO() }}",
        "end": "={{ $now.plus({days: 2}).startOf('day').plus({hours: 10, minutes: 30}).toISO() }}",
        "description": "=SalesFlow CRM — Auto-Scheduled Discovery Call\n\n🎯 Lead: {{ $json.full_name }}\n🏢 Company: {{ $json.company }}\n📧 Email: {{ $json.email }}\n📱 Phone: {{ $json.phone }}\n💰 Budget: {{ $json.budget }}\n🏆 Score: {{ $json.composite_score || $json.initial_score }}/100\n\n📋 Recommended Product: {{ $json.recommended_product }}\n\n🤖 AI Suggested Opening:\n{{ $json.recommended_script || 'Tell me about your current sales process and biggest challenges' }}",
        "additionalFields": {
          "attendees": [
            "={{ $json.email }}",
            "={{ $json.rep_email }}"
          ],
          "sendUpdates": "all",
          "conferenceDataVersion": 1
        }
      },
      "id": "gcal-node-004",
      "name": "Google Calendar: Schedule Discovery Call",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [
        1240,
        360
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "google-calendar-oauth",
          "name": "Google Calendar Sales"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "create",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "follow_ups",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "lead_id": "={{ $json.lead_id }}",
            "followup_number": "={{ ($json.followup_count || 0) + 1 }}",
            "type": "EMAIL",
            "sent_by": "={{ $json.rep_name }}",
            "sent_at": "={{ $now.toISO() }}",
            "status": "SENT"
          }
        },
        "options": {}
      },
      "id": "postgres-node-004b",
      "name": "Postgres: Log Follow-up",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1240,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-crm-db",
          "name": "CRM PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "External integration failed after retries; execution stopped and retained for review."
      },
      "id": "78e63557-a41c-4e1c-b29b-b35580f8a87d",
      "name": "Stop: Capture Integration Error",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1520,
        420
      ]
    }
  ],
