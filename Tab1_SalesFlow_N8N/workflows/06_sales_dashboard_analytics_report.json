      "parameters": {
        "jsCode": "return [{\n  json: {\n    total_pipeline_value: \"$845,000\",\n    active_deals: 55,\n    win_rate_pct: 68.4,\n    avg_deal_size: \"$42,250\",\n    leads_this_week: 14\n  }\n}];"
