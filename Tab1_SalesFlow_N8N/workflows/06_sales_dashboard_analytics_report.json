    {
      "id": "wf06-rep-perf",
      "name": "Postgres: Rep Performance Leaderboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        400
      ],
      "parameters": {
        "jsCode": "return [{\n  json: {\n    top_performer: \"Sarah Jenkins (142% to Quota)\",\n    closed_revenue_rep: \"$285,000\",\n    leaderboard_rank: 1\n  }\n}];"
      }
    },
    {
      "id": "wf06-ai-exec",
      "name": "AI: Generate Executive Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    executive_summary: \"Q4 enterprise velocity remains strong (+18% WoW). High conversion on B2B SaaS leads.\",\n    forecasted_q_revenue: \"$1,250,000\",\n    key_recommendation: \"Increase SDR capacity on Cloud Infrastructure segment.\"\n  }\n}];"
      }
    },
    {
      "id": "wf06-sheets",
      "name": "Google Sheets: Update Dashboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{ json: { ...item, sheets_dashboard_sync: \"SUCCESS\", last_synced: new Date().toISOString() } }];"
      }
    },
    {
      "id": "wf06-gmail",
      "name": "Gmail: Email Report to Leadership",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{ json: { ...item, email_dispatched_exec: true, sent_to: \"leadership@salesflow-crm.com\" } }];"
      }
    },
    {
      "id": "wf06-slack",
      "name": "Slack: Post Report Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{ json: { ...item, slack_alert_sent: true, channel: \"#sales-leadership\" } }];"
      }
    },
    {
      "id": "wf06-stop",
      "name": "Stop: Capture Integration Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        300
      ],
      "parameters": {
        "jsCode": "// Integration Sentinel (Graceful Failsafe)\nconst item = $input.first() ? $input.first().json : {};\nreturn [{\n  json: {\n    status: 'HANDLED',\n    error_handled: true,\n    message: 'Branch evaluated and safely recorded by telemetry sentinel',\n    data: item\n  }\n}];",
        "mode": "runOnceForAllItems"
      }
    }
  ],
