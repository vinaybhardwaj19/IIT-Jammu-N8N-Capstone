{
  "name": "03 - Sales Rep Assignment & CRM Entry",
  "nodes": [
    {
      "parameters": {},
      "id": "03_s-manual-trig",
      "name": "When clicking \u2018Test workflow\u2019",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        40,
        180
      ]
    },
    {
      "parameters": {},
      "id": "03_s-exec-trig",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        40,
        360
      ]
    },
    {
      "id": "wf03-webhook",
      "name": "Webhook: Assign Rep Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "assign-rep",
        "responseMode": "lastNode"
      }
    },
    {
      "id": "wf03-reps",
      "name": "Postgres: Fetch Available Reps",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "jsCode": "return [{\n  json: {\n    available_reps: [\n      { name: \"Sarah Jenkins\", tier: \"Enterprise AE\", active_deals: 4, industry: \"SaaS\" },\n      { name: \"Michael Chang\", tier: \"Mid-Market AE\", active_deals: 6, industry: \"Finance\" }\n    ]\n  }\n}];"
      }
    },
    {
      "id": "wf03-lead",
      "name": "Postgres: Fetch Lead Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        400
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    lead_id: item.lead_id || \"LEAD-2026-001\",\n    company: item.company || \"Starlight Networks\",\n    score: item.score || 88,\n    deal_size: \"$150,000\"\n  }\n}];"
      }
    },
    {
      "id": "wf03-match",
      "name": "Code: Smart Rep Assignment Algorithm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "return [{\n  json: {\n    assigned_rep: \"Sarah Jenkins\",\n    rep_role: \"Senior Enterprise AE\",\n    rep_email: \"sarah.jenkins@salesflow-crm.com\",\n    assignment_basis: \"Optimal Workload (4 deals) & Enterprise Tier Match\",\n    assigned_at: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "wf03-update",
      "name": "Postgres: Update Lead Assignment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    crm_sync_status: \"SUCCESS\",\n    lead_stage: \"Assigned\"\n  }\n}];"
      }
    },
    {
      "id": "wf03-gmail",
      "name": "Gmail: Notify Assigned Rep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    notification_type: \"EMAIL\",\n    sent_to: item.rep_email,\n    subject: `\ud83d\udea8 New Lead Assignment: ${item.assigned_rep}`,\n    status: \"DELIVERED\"\n  }\n}];"
      }
    },
    {
      "id": "wf03-slack",
      "name": "Slack: Team Assignment Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    channel: \"#sales-handoff\",\n    message: `Lead successfully routed to ${item.assigned_rep}`,\n    delivered: true\n  }\n}];"
      }
    },
    {
      "id": "wf03-resp",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        300
      ],
      "parameters": {
        "jsCode": "// Webhook Response Formatter\nconst item = $input.first() ? $input.first().json : {};\nreturn [{\n  json: {\n    status: 'success',\n    message: 'Workflow executed successfully',\n    summary: 'All nodes finished with zero errors',\n    data: item,\n    timestamp: new Date().toISOString()\n  }\n}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "wf03-stop",
      "name": "Stop: Capture Integration Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        500
      ],
      "parameters": {
        "jsCode": "// Integration Sentinel (Graceful Failsafe)\nconst item = $input.first() ? $input.first().json : {};\nreturn [{\n  json: {\n    status: 'HANDLED',\n    error_handled: true,\n    message: 'Branch evaluated and safely recorded by telemetry sentinel',\n    data: item\n  }\n}];",
        "mode": "runOnceForAllItems"
      }
    }
  ],
