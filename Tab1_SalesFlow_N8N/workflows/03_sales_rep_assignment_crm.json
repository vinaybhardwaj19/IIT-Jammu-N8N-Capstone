{
  "name": "03 - Sales Rep Assignment & CRM Entry",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "assign-rep",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node-003",
      "name": "Webhook: Assign Rep Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.*, \n  COUNT(l.id) as current_lead_count,\n  AVG(l.composite_score) as avg_deal_quality\nFROM sales_reps r\nLEFT JOIN leads l ON l.assigned_rep = r.rep_id AND l.status NOT IN ('CLOSED_WON','CLOSED_LOST')\nWHERE r.is_active = true\nGROUP BY r.id\nORDER BY current_lead_count ASC, r.performance_score DESC\nLIMIT 10",
        "options": {}
      },
      "id": "postgres-node-003a",
      "name": "Postgres: Fetch Available Reps",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-crm-db",
          "name": "CRM PostgreSQL"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM leads WHERE lead_id = '{{ $('Webhook: Assign Rep Trigger').json.body.lead_id }}'",
        "options": {}
      },
      "id": "postgres-node-003b",
      "name": "Postgres: Fetch Lead Details",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        440,
        480
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-crm-db",
          "name": "CRM PostgreSQL"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Smart Round-Robin + Expertise Matching Algorithm\nconst reps = $('Postgres: Fetch Available Reps').all().map(item => item.json);\nconst lead = $('Postgres: Fetch Lead Details').first().json;\n\n// Industry expertise matching\nconst industryExpertiseMap = {\n  'Technology': ['tech', 'software', 'saas'],\n  'Finance': ['finance', 'banking', 'fintech'],\n  'Healthcare': ['healthcare', 'pharma', 'medical'],\n  'Manufacturing': ['manufacturing', 'industrial'],\n  'Retail': ['retail', 'ecommerce', 'consumer']\n};\n\nlet bestRep = null;\nlet bestScore = -1;\n\nfor (const rep of reps) {\n  let score = 0;\n  \n  // Workload score: lower workload = higher score\n  score += Math.max(0, 20 - rep.current_lead_count) * 2;\n  \n  // Performance score\n  score += (rep.performance_score || 70) * 0.5;\n  \n  // Industry expertise bonus\n  const repSpecialties = (rep.industry_specialties || '').toLowerCase();\n  const leadIndustry = (lead.industry || '').toLowerCase();\n  if (repSpecialties.includes(leadIndustry) || \n      Object.entries(industryExpertiseMap).some(([k,v]) => \n        k.toLowerCase() === leadIndustry && v.some(s => repSpecialties.includes(s)))) {\n    score += 30;\n  }\n  \n  // Tier bonus for hot leads\n  if (lead.priority_tier === 'Tier1' && rep.tier_level === 'Senior') {\n    score += 20;\n  }\n  \n  if (score > bestScore) {\n    bestScore = score;\n    bestRep = rep;\n  }\n}\n\n// Fallback: pick least loaded rep\nif (!bestRep && reps.length > 0) {\n  bestRep = reps.sort((a,b) => a.current_lead_count - b.current_lead_count)[0];\n}\n\nreturn {\n  ...lead,\n  assigned_rep_id: bestRep?.rep_id || 'UNASSIGNED',\n  assigned_rep_name: bestRep?.full_name || 'Sales Manager',\n  assigned_rep_email: bestRep?.email || 'sales@company.com',\n  assigned_rep_phone: bestRep?.phone || '',\n  assignment_score: bestScore,\n  assignment_reason: bestRep ? `Best match: ${bestScore} pts (workload + expertise + performance)` : 'Manual assignment required',\n  assigned_at: new Date().toISOString()\n};"
      },
      "id": "code-node-003",
      "name": "Code: Smart Rep Assignment Algorithm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        380
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "leads",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "assigned_rep": "={{ $json.assigned_rep_id }}",
            "status": "ASSIGNED",
            "assigned_at": "={{ $json.assigned_at }}"
          }
        },
        "where": {
          "values": [
            {
              "column": "lead_id",
              "value": "={{ $json.lead_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "postgres-node-003c",
      "name": "Postgres: Update Lead Assignment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        840,
        380
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-crm-db",
          "name": "CRM PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.assigned_rep_email }}",
        "subject": "=🎯 New Lead Assigned: {{ $json.full_name }} from {{ $json.company }} [{{ $json.priority_tier }}]",
        "emailType": "html",
        "message": "=<html><body style='font-family:Arial,sans-serif;max-width:650px;margin:0 auto;'>\n<div style='background:#1a1a2e;padding:25px;border-radius:10px;'>\n  <h2 style='color:#e94560;margin:0;'>🎯 New Lead Assignment</h2>\n  <p style='color:#aaa;'>SalesFlow CRM Notification</p>\n</div>\n<div style='padding:25px;background:#f8f9ff;'>\n  <h3>Hi {{ $json.assigned_rep_name }},</h3>\n  <p>A new lead has been assigned to you based on your expertise. Here's everything you need to know:</p>\n  \n  <div style='background:white;padding:20px;border-radius:8px;border:1px solid #e0e0e0;margin-bottom:15px;'>\n    <h4 style='color:#1a1a2e;border-bottom:2px solid #e94560;padding-bottom:8px;'>👤 Lead Information</h4>\n    <table style='width:100%;'>\n      <tr><td><strong>Name:</strong></td><td>{{ $json.full_name }}</td></tr>\n      <tr><td><strong>Company:</strong></td><td>{{ $json.company }}</td></tr>\n      <tr><td><strong>Industry:</strong></td><td>{{ $json.industry }}</td></tr>\n      <tr><td><strong>Email:</strong></td><td>{{ $json.email }}</td></tr>\n      <tr><td><strong>Phone:</strong></td><td>{{ $json.phone }}</td></tr>\n      <tr><td><strong>Budget:</strong></td><td>{{ $json.budget }}</td></tr>\n    </table>\n  </div>\n  \n  <div style='background:#fff3cd;padding:15px;border-radius:8px;border-left:4px solid #ffc107;margin-bottom:15px;'>\n    <h4 style='margin:0 0 10px;'>📊 AI Analysis Summary</h4>\n    <p><strong>Score:</strong> {{ $json.composite_score || $json.initial_score }}/100</p>\n    <p><strong>Temperature:</strong> {{ $json.lead_temperature }}</p>\n    <p><strong>Deal Probability:</strong> {{ $json.deal_probability_percent || 'N/A' }}%</p>\n    <p><strong>Recommended Product:</strong> {{ $json.recommended_product }}</p>\n    <p><strong>Next Action:</strong> {{ $json.next_action || 'Initial contact call' }}</p>\n  </div>\n  \n  <div style='background:#d4edda;padding:15px;border-radius:8px;border-left:4px solid #28a745;'>\n    <h4 style='margin:0 0 10px;'>💬 AI-Suggested Discovery Script</h4>\n    <p style='font-style:italic;'>{{ $json.recommended_script || 'Hi [Name], I noticed you expressed interest in our CRM solutions. Tell me about your current sales process — what's the biggest challenge your team faces?' }}</p>\n  </div>\n  \n  <div style='text-align:center;margin-top:20px;'>\n    <a href='https://crm.salesflow.com/leads/{{ $json.lead_id }}' style='display:inline-block;padding:12px 30px;background:#e94560;color:white;text-decoration:none;border-radius:6px;margin-right:10px;'>View in CRM →</a>\n    <a href='https://crm.salesflow.com/call/{{ $json.lead_id }}' style='display:inline-block;padding:12px 30px;background:#1a1a2e;color:white;text-decoration:none;border-radius:6px;'>Log a Call</a>\n  </div>\n</div>\n</body></html>",
        "options": {}
      },
