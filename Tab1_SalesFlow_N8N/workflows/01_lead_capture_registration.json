{
  "name": "01 - Lead Capture & Registration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "capture-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node-001",
      "name": "Webhook: New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "full_name",
              "value": "={{ $json.body.full_name }}"
            },
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "phone",
              "value": "={{ $json.body.phone }}"
            },
            {
              "name": "company",
              "value": "={{ $json.body.company }}"
            },
            {
              "name": "industry",
              "value": "={{ $json.body.industry }}"
            },
            {
              "name": "budget",
              "value": "={{ $json.body.budget }}"
            },
            {
              "name": "source",
              "value": "={{ $json.body.source || 'Website' }}"
            },
            {
              "name": "lead_id",
              "value": "=LEAD-{{ $now.toFormat('yyyyMMddHHmmss') }}"
            },
            {
              "name": "created_at",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-node-001",
      "name": "Set: Format Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "apiKey",
        "resource": "chat",
        "model": "gpt-4o",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a professional sales CRM assistant. Your job is to analyze incoming lead data and extract structured business intelligence. Always respond in valid JSON format."
            },
            {
              "role": "user",
              "content": "=Analyze this new sales lead and provide a JSON object with the following fields:\n- initial_score (0-100 integer based on budget, company size, industry fit)\n- lead_temperature (Hot/Warm/Cold)\n- priority_tier (Tier1/Tier2/Tier3)\n- recommended_product (which of our products suits them best based on industry)\n- personalized_welcome_message (2-3 sentences, professional and warm)\n- estimated_deal_size (Small/Medium/Large/Enterprise)\n- follow_up_urgency (Immediate/Within24h/Within48h/ThisWeek)\n\nLead Data:\n- Name: {{ $json.full_name }}\n- Email: {{ $json.email }}\n- Company: {{ $json.company }}\n- Industry: {{ $json.industry }}\n- Budget: {{ $json.budget }}\n- Source: {{ $json.source }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 600
        }
      },
      "id": "openai-node-001",
      "name": "AI: Analyze & Score Lead",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        640,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response and merge with lead data\nconst aiResponse = $input.item.json.choices[0].message.content;\nlet analysis = {};\ntry {\n  const jsonMatch = aiResponse.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    analysis = JSON.parse(jsonMatch[0]);\n  }\n} catch(e) {\n  analysis = {\n    initial_score: 50,\n    lead_temperature: 'Warm',\n    priority_tier: 'Tier2',\n    recommended_product: 'SalesFlow Pro',\n    personalized_welcome_message: `Thank you for your interest! We're excited to connect with ${$node['Set: Format Lead Data'].json.full_name} from ${$node['Set: Format Lead Data'].json.company}.`,\n    estimated_deal_size: 'Medium',\n    follow_up_urgency: 'Within24h'\n  };\n}\n\nconst leadData = $node['Set: Format Lead Data'].json;\n\nreturn {\n  ...leadData,\n  ...analysis,\n  status: 'NEW',\n  assigned_rep: null,\n  workflow_stage: 'Registration'\n};"
      },
      "id": "code-node-001",
      "name": "Code: Merge Lead + AI Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "leads",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "lead_id": "={{ $json.lead_id }}",
            "full_name": "={{ $json.full_name }}",
            "email": "={{ $json.email }}",
            "phone": "={{ $json.phone }}",
            "company": "={{ $json.company }}",
            "industry": "={{ $json.industry }}",
            "budget": "={{ $json.budget }}",
            "source": "={{ $json.source }}",
            "initial_score": "={{ $json.initial_score }}",
            "lead_temperature": "={{ $json.lead_temperature }}",
            "priority_tier": "={{ $json.priority_tier }}",
            "recommended_product": "={{ $json.recommended_product }}",
            "estimated_deal_size": "={{ $json.estimated_deal_size }}",
            "follow_up_urgency": "={{ $json.follow_up_urgency }}",
            "status": "={{ $json.status }}",
            "created_at": "={{ $json.created_at }}"
          }
        },
        "options": {}
      },
      "id": "postgres-node-001",
      "name": "Postgres: Save Lead to CRM DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-crm-db",
          "name": "CRM PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=🎉 Welcome to SalesFlow CRM, {{ $json.full_name }}! Your Journey Starts Here",
        "emailType": "html",
        "message": "=<html>\n<body style='font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;'>\n  <div style='background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 30px; border-radius: 10px; text-align: center;'>\n    <h1 style='color: white; margin: 0;'>🚀 SalesFlow CRM</h1>\n    <p style='color: #e8e8e8;'>AI-Powered Sales Automation</p>\n  </div>\n  <div style='padding: 30px; background: #f9f9f9;'>\n    <h2>Hello {{ $json.full_name }}! 👋</h2>\n    <p>{{ $json.personalized_welcome_message }}</p>\n    <div style='background: white; padding: 20px; border-radius: 8px; border-left: 4px solid #667eea;'>\n      <h3 style='color: #667eea;'>Your Lead Profile</h3>\n      <p><strong>Lead ID:</strong> {{ $json.lead_id }}</p>\n      <p><strong>Company:</strong> {{ $json.company }}</p>\n      <p><strong>Priority:</strong> {{ $json.priority_tier }}</p>\n      <p><strong>Recommended Solution:</strong> {{ $json.recommended_product }}</p>\n    </div>\n    <p style='margin-top: 20px;'>Our sales team will reach out to you {{ $json.follow_up_urgency === 'Immediate' ? 'immediately' : 'soon' }}. In the meantime, feel free to explore our offerings.</p>\n    <a href='https://salesflow-crm.com/demo' style='display: inline-block; padding: 12px 24px; background: #667eea; color: white; text-decoration: none; border-radius: 6px; margin-top: 15px;'>Book a Free Demo →</a>\n  </div>\n  <div style='text-align: center; padding: 20px; color: #999; font-size: 12px;'>\n    <p>SalesFlow CRM | Enterprise Sales Automation | support@salesflow-crm.com</p>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "gmail-node-001",
      "name": "Gmail: Welcome Email to Lead",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1240,
        200
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-oauth",
          "name": "Gmail Sales Account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.lead_temperature }}",
              "rightValue": "Hot",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-node-001",
      "name": "IF: Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1240,
        420
      ]
    },
    {
      "parameters": {
        "channel": "#hot-leads-alert",
        "text": "=🔥 *HOT LEAD ALERT!*\n\n*Name:* {{ $json.full_name }}\n*Company:* {{ $json.company }}\n*Industry:* {{ $json.industry }}\n*Budget:* {{ $json.budget }}\n*Score:* {{ $json.initial_score }}/100\n*Lead ID:* {{ $json.lead_id }}\n\n👆 Assign immediately — this lead needs instant attention!",
        "options": {
          "unfurl_links": false
        }
      },
      "id": "slack-node-001",
      "name": "Slack: Hot Lead Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1440,
        360
      ],
      "credentials": {
        "slackApi": {
          "id": "slack-sales-workspace",
          "name": "SalesFlow Slack"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"lead_id\": \"{{ $node['Code: Merge Lead + AI Analysis'].json.lead_id }}\",\n  \"message\": \"Lead registered successfully. Welcome email sent!\",\n  \"score\": {{ $node['Code: Merge Lead + AI Analysis'].json.initial_score }},\n  \"temperature\": \"{{ $node['Code: Merge Lead + AI Analysis'].json.lead_temperature }}\",\n  \"priority\": \"{{ $node['Code: Merge Lead + AI Analysis'].json.priority_tier }}\"\n}",
        "options": {}
      },
      "id": "webhook-response-001",
      "name": "Webhook Response: Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1640,
        300
      ]
    },
    {
