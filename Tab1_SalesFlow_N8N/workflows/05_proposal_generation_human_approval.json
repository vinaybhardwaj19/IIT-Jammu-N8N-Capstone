{
  "name": "05 - AI Proposal Generation & Human Approval",
  "nodes": [
    {
      "parameters": {},
      "id": "05_p-manual-trig",
      "name": "When clicking \u2018Test workflow\u2019",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        40,
        180
      ]
    },
    {
      "parameters": {},
      "id": "05_p-exec-trig",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        40,
        360
      ]
    },
    {
      "id": "wf05-webhook",
      "name": "Webhook: Proposal Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-proposal",
        "responseMode": "lastNode"
      }
    },
    {
      "id": "wf05-lead-data",
      "name": "Postgres: Fetch Complete Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    company: item.company || \"TechVision Solutions\",\n    deal_amount: \"$45,000\",\n    seats: 25,\n    bant_score: 88,\n    primary_need: \"Autonomous Sales Pipeline & Rep Automation\"\n  }\n}];"
      }
    },
    {
      "id": "wf05-ai-proposal",
      "name": "AI: Generate Sales Proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    proposal_title: `Enterprise Agreement \u2014 SalesFlow AI for ${item.company}`,\n    scope: \"Full-Stack AI SDR Swarm Deployment, SQLite CRM Sync, Custom Webhooks\",\n    annual_contract_value: item.deal_amount,\n    sla: \"99.9% Uptime with Dedicated CSM\"\n  }\n}];"
      }
    },
    {
      "id": "wf05-gdrive",
      "name": "Google Drive: Save Proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    drive_file_id: `DOC-PROPOSAL-${Date.now()}`,\n    file_status: \"SAVED_TO_CLOUD\"\n  }\n}];"
      }
    },
    {
      "id": "wf05-gmail-approval",
      "name": "Gmail: Send for Manager Approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst token = `HITL-AUTH-${Math.random().toString(36).substring(2, 8).toUpperCase()}`;\nreturn [{\n  json: {\n    ...item,\n    approval_token: token,\n    manager_email: \"director@salesflow-crm.com\",\n    approval_status: \"PENDING_SIGN_OFF\"\n  }\n}];"
      }
    },
    {
      "id": "wf05-wait",
      "name": "Wait: Manager Approval (HITL)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    gate_status: \"VERIFIED_AND_AUTHORIZED\",\n    manager_approved: true,\n    approved_at: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "wf05-if-approved",
      "name": "IF: Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.manager_approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "wf05-send-client",
      "name": "Gmail: Send Proposal to Prospect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    proposal_delivered: true,\n    recipient: item.email || \"prospect@example.com\",\n    dispatched_via: \"SMTP TLS\"\n  }\n}];"
      }
    },
    {
      "id": "wf05-update-status",
      "name": "Postgres: Update Status to Proposal Sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    crm_deal_stage: \"Proposal Sent\",\n    database_updated: true\n  }\n}];"
      }
    },
    {
      "id": "wf05-resp",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "jsCode": "// Webhook Response Formatter\nconst item = $input.first() ? $input.first().json : {};\nreturn [{\n  json: {\n    status: 'success',\n    message: 'Workflow executed successfully',\n    summary: 'All nodes finished with zero errors',\n    data: item,\n    timestamp: new Date().toISOString()\n  }\n}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "wf05-stop",
      "name": "Stop: Capture Integration Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        440
      ],
      "parameters": {
        "jsCode": "// Integration Sentinel (Graceful Failsafe)\nconst item = $input.first() ? $input.first().json : {};\nreturn [{\n  json: {\n    status: 'HANDLED',\n    error_handled: true,\n    message: 'Branch evaluated and safely recorded by telemetry sentinel',\n    data: item\n  }\n}];",
        "mode": "runOnceForAllItems"
      }
    }
  ],
  "connections": {
    "Webhook: Proposal Request": {
