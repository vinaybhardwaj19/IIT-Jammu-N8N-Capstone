{
  "name": "05 - AI Proposal Generation & Human Approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-proposal",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node-005",
      "name": "Webhook: Proposal Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, r.full_name as rep_name, r.email as rep_email,\n  r.phone as rep_phone, r.linkedin_url as rep_linkedin\nFROM leads l\nJOIN sales_reps r ON l.assigned_rep = r.rep_id\nWHERE l.lead_id = '{{ $json.body.lead_id }}'",
        "options": {}
      },
      "id": "postgres-node-005a",
      "name": "Postgres: Fetch Complete Lead Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-crm-db",
          "name": "CRM PostgreSQL"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "authentication": "apiKey",
        "resource": "chat",
        "model": "gpt-4o",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a world-class enterprise sales proposal writer. You create compelling, professional proposals that are highly personalized, ROI-focused, and designed to close deals. Format all proposals in clean HTML with professional styling. Include executive summary, problem statement, proposed solution, pricing tiers, ROI calculation, timeline, and next steps."
            },
            {
              "role": "user",
              "content": "=Create a comprehensive sales proposal HTML document for this prospect. Make it look premium and highly professional.\n\nProspect Details:\n- Company: {{ $json.company }}\n- Contact: {{ $json.full_name }}, {{ $json.email }}\n- Industry: {{ $json.industry }}\n- Budget: {{ $json.budget }}\n- Recommended Product: {{ $json.recommended_product }}\n- Deal Size: {{ $json.estimated_deal_size }}\n- Deal Probability: {{ $json.deal_probability_percent }}%\n- Pain Points: Standard {{ $json.industry }} challenges\n\nOur Company: SalesFlow CRM\nOur Product Tiers:\n- Starter: $299/month (up to 5 users, basic automation)\n- Professional: $799/month (up to 20 users, AI features)\n- Enterprise: $2499/month (unlimited users, full AI suite, dedicated support)\n\nCreate a full HTML proposal with:\n1. Executive Summary personalized to {{ $json.company }}\n2. Current Challenges in {{ $json.industry }} sector\n3. Our Solution tailored to their needs\n4. 3-tier pricing recommendation\n5. ROI Calculator (estimate 3x revenue in 6 months)\n6. Implementation Timeline (4-week plan)\n7. Why SalesFlow vs competitors\n8. Next Steps with specific dates\n\nMake it visually beautiful with dark blue/purple gradient headers, professional tables, and persuasive copy."
            }
          ]
        },
        "options": {
          "temperature": 0.4,
          "maxTokens": 3000
        }
      },
      "id": "openai-node-005",
      "name": "AI: Generate Sales Proposal",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        640,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "name": "=SalesFlow_Proposal_{{ $node['Postgres: Fetch Complete Lead Data'].json.company.replace(/\\s/g,'_') }}_{{ $now.toFormat('yyyyMMdd') }}.html",
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "list"
        },
        "folderId": {
          "__rl": true,
          "value": "PROPOSALS_FOLDER_ID",
          "mode": "id"
        },
        "binaryData": false,
        "fileContent": "={{ $node['AI: Generate Sales Proposal'].json.choices[0].message.content }}",
        "options": {
          "mimeType": "text/html"
        }
      },
      "id": "gdrive-node-005",
      "name": "Google Drive: Save Proposal",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        840,
        300
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "google-drive-oauth",
          "name": "Google Drive Sales"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "sendTo": "sales.manager@salesflow-crm.com",
        "subject": "=⚠️ APPROVAL REQUIRED: Proposal for {{ $node['Postgres: Fetch Complete Lead Data'].json.company }} (${{ $node['Postgres: Fetch Complete Lead Data'].json.budget }})",
        "emailType": "html",
        "message": "=<html><body style='font-family:Arial,sans-serif;max-width:650px;margin:0 auto;'>\n<div style='background:#dc3545;padding:20px;border-radius:10px;color:white;'>\n  <h2>⚠️ Proposal Approval Required</h2>\n  <p>A new sales proposal requires your review and approval.</p>\n</div>\n<div style='padding:25px;background:#f8f9fa;'>\n  <h3>Proposal Details</h3>\n  <table style='width:100%;border-collapse:collapse;'>\n    <tr style='background:#e9ecef;'><td style='padding:8px;border:1px solid #dee2e6;'><strong>Company</strong></td><td style='padding:8px;border:1px solid #dee2e6;'>{{ $node['Postgres: Fetch Complete Lead Data'].json.company }}</td></tr>\n    <tr><td style='padding:8px;border:1px solid #dee2e6;'><strong>Contact</strong></td><td style='padding:8px;border:1px solid #dee2e6;'>{{ $node['Postgres: Fetch Complete Lead Data'].json.full_name }}</td></tr>\n    <tr style='background:#e9ecef;'><td style='padding:8px;border:1px solid #dee2e6;'><strong>Budget</strong></td><td style='padding:8px;border:1px solid #dee2e6;'>{{ $node['Postgres: Fetch Complete Lead Data'].json.budget }}</td></tr>\n    <tr><td style='padding:8px;border:1px solid #dee2e6;'><strong>Deal Size</strong></td><td style='padding:8px;border:1px solid #dee2e6;'>{{ $node['Postgres: Fetch Complete Lead Data'].json.estimated_deal_size }}</td></tr>\n    <tr style='background:#e9ecef;'><td style='padding:8px;border:1px solid #dee2e6;'><strong>Close Probability</strong></td><td style='padding:8px;border:1px solid #dee2e6;'>{{ $node['Postgres: Fetch Complete Lead Data'].json.deal_probability_percent }}%</td></tr>\n    <tr><td style='padding:8px;border:1px solid #dee2e6;'><strong>Google Drive Link</strong></td><td style='padding:8px;border:1px solid #dee2e6;'><a href='{{ $json.webViewLink }}'>View Proposal →</a></td></tr>\n  </table>\n  \n  <div style='margin-top:25px;text-align:center;'>\n    <p><strong>Please approve or reject this proposal:</strong></p>\n    <a href='{{ $execution.resumeUrl }}&approved=yes&manager=sales_manager' style='display:inline-block;padding:14px 28px;background:#28a745;color:white;text-decoration:none;border-radius:6px;margin-right:10px;font-size:16px;'>✅ APPROVE</a>\n    <a href='{{ $execution.resumeUrl }}&approved=no&manager=sales_manager&reason=review_needed' style='display:inline-block;padding:14px 28px;background:#dc3545;color:white;text-decoration:none;border-radius:6px;font-size:16px;'>❌ REJECT</a>\n  </div>\n  <p style='color:#999;font-size:12px;text-align:center;margin-top:15px;'>This approval link expires in 48 hours.</p>\n</div>\n</body></html>",
        "options": {}
      },
      "id": "gmail-node-005a",
      "name": "Gmail: Send for Manager Approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-oauth",
          "name": "Gmail Sales Account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {
          "webhookSuffix": "approval-response",
          "responseCode": 200,
          "responseData": "Approval received! Thank you for your decision."
        }
      },
      "id": "wait-node-005",
      "name": "Wait: Manager Approval (HITL)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.query.approved }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-node-005",
      "name": "IF: Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $node['Postgres: Fetch Complete Lead Data'].json.email }}",
        "subject": "=🎉 Your Personalized Proposal from SalesFlow CRM is Ready!",
        "emailType": "html",
        "message": "=<html><body style='font-family:Arial,sans-serif;max-width:650px;'>\n<div style='background:linear-gradient(135deg,#667eea,#764ba2);padding:25px;border-radius:10px;text-align:center;'>\n  <h1 style='color:white;'>Your Custom Proposal is Ready!</h1>\n</div>\n<div style='padding:25px;'>\n  <p>Dear {{ $node['Postgres: Fetch Complete Lead Data'].json.full_name }},</p>\n  <p>We're excited to share a personalized proposal specifically crafted for <strong>{{ $node['Postgres: Fetch Complete Lead Data'].json.company }}</strong>.</p>\n  <p>Our solution addresses your specific challenges in the <strong>{{ $node['Postgres: Fetch Complete Lead Data'].json.industry }}</strong> sector and is designed to deliver measurable ROI within 90 days.</p>\n  <a href='{{ $node['Google Drive: Save Proposal'].json.webViewLink }}' style='display:inline-block;padding:14px 28px;background:#667eea;color:white;text-decoration:none;border-radius:6px;margin:15px 0;'>📄 View Your Proposal →</a>\n  <p>Your dedicated account manager, <strong>{{ $node['Postgres: Fetch Complete Lead Data'].json.rep_name }}</strong>, will call you within 24 hours to walk through it together.</p>\n  <p>Best regards,<br>{{ $node['Postgres: Fetch Complete Lead Data'].json.rep_name }}<br>SalesFlow CRM</p>\n</div>\n</body></html>",
        "options": {}
      },
      "id": "gmail-node-005b",
      "name": "Gmail: Send Proposal to Prospect",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1640,
        200
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-oauth",
          "name": "Gmail Sales Account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "leads",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "PROPOSAL_SENT",
            "proposal_url": "={{ $node['Google Drive: Save Proposal'].json.webViewLink }}",
            "proposal_sent_at": "={{ $now.toISO() }}"
          }
        },
        "where": {
          "values": [
            {
              "column": "lead_id",
              "value": "={{ $node['Postgres: Fetch Complete Lead Data'].json.lead_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "postgres-node-005b",
      "name": "Postgres: Update Status to Proposal Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1640,
        380
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-crm-db",
          "name": "CRM PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"proposal_url\": \"{{ $node['Google Drive: Save Proposal'].json.webViewLink }}\", \"status\": \"PROPOSAL_SENT\"}",
        "options": {}
      },
      "id": "webhook-response-005",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1640,
        540
      ]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "External integration failed after retries; execution stopped and retained for review."
      },
      "id": "08344031-6725-451f-8d7f-78e27da81664",
      "name": "Stop: Capture Integration Error",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1920,
        540
      ]
    }
  ],
