# ==============================================================================
# SalesAI SDR & SalesFlow N8N Platform — Environment Template
# ==============================================================================
# Instructions:
# Copy this file to .env and insert your real credentials.
# NEVER commit your real .env file or API keys to source control.
# ==============================================================================

# The six SalesAI Agents SDK agents require this OpenAI key.
OPENAI_AGENT_MODEL=gpt-4.1-mini

# Compatibility helper provider (used by non-agent utilities only).
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended, Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API Key (Optional / Fallback, Free tier available at https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Any other OpenAI-compatible provider (for example a custom gateway)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Application Server Settings
PORT=7860
API_PORT=8000
ENVIRONMENT=development

# Optional SMTP settings. Sending is disabled unless valid credentials are present.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=SalesAI SDR

# Optional N8N / PostgreSQL Settings (For self-hosted production N8N deployment)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/
# Live webhook calls stay disabled unless explicitly enabled for a sandbox.
N8N_ALLOW_LIVE_EXECUTION=false
# Set true only after removing duplicate active capture-lead paths in n8n.
N8N_WF01_DUPLICATE_PATH_RESOLVED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=salesflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
